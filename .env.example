# ─────────────────────────────────────────────
# ZOMBI // AI — Variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# ─────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Proveedor de IA: Gemini (plan gratuito)
# Obtén tu clave en https://aistudio.google.com/apikey
#   SI DEJAS GEMINI_API_KEY VACÍA:
#   el servidor arranca en "modo simulación" (responde con un
#   simulacro + el contexto recuperado por el RAG), ideal para
#   desarrollar sin credenciales ni gasto de cuota.
# ─────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Límites del plan gratuito (peticiones por minuto y por día)
GEMINI_RPM=10
GEMINI_DAILY_REQUESTS=1500
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# ─────────────────────────────────────────────
# Base de datos SQLite
# ─────────────────────────────────────────────
DB_PATH=./storage/zombies.db
DB_ENABLED=true

# ─────────────────────────────────────────────
# Base de conocimiento (RAG)
# ─────────────────────────────────────────────
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.3
RAG_DATA_DIR=./data/knowledge