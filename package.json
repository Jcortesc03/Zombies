{
  "name": "zombi-ai-assistant",
  "version": "1.0.0",
  "description": "Asistente de IA responsive que responde preguntas sobre la saga de Call of Duty: Black Ops Zombies",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed-db.js",
    "test:ai": "node scripts/test-gemini.js",
    "build:kb": "node scripts/build-knowledge.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint ."
  },
  "keywords": [
    "ai",
    "assistant",
    "call-of-duty",
    "black-ops",
    "zombies",
    "rag",
    "gemini"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.0.0",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^9.13.0"
  }
}
